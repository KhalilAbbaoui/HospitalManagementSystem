@model ApplicationUser

@{
    ViewData["Title"] = "Patient Informations";
}

<!-- Header Section -->
<div class="admin-header d-flex flex-wrap justify-content-between align-items-center p-4 mb-4 shadow-sm bg-white rounded">
    <div class="d-flex align-items-center">
        <i class="fas fa-user-injured fa-2x text-primary me-3"></i>
        <div>
            <h1 class="h3 mb-0" id="timeGreeting"></h1>
           
        </div>
    </div>
    <div class="header-actions mt-2 mt-md-0">
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary me-2">
            <i class="fas fa-calendar-plus me-2"></i>Add Appointment
        </a>
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-sign-out-alt me-2"></i>Logout
            </button>
        </form>
    </div>
</div>

<!-- Patient Details Card -->
<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="card-title mb-0"><i class="fas fa-info-circle me-2"></i>Patient Details</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">Full Name</label>
                    <p class="form-control-static">@Model.FullName</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Email</label>
                    <p class="form-control-static">@Model.Email</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Phone Number</label>
                    <p class="form-control-static">@Model.PhoneNumber</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">Address</label>
                    <p class="form-control-static">@Model.Address</p>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Date of Birth</label>
                    <p class="form-control-static">
                        @(Model.DateOfBirth.HasValue ?
                            Model.DateOfBirth.Value.ToShortDateString() :
                            "N/A")
                    </p>
                </div>
            </div>
        </div>
    </div>
    <div class="card-footer bg-light">
        <a asp-controller="Patients" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
            <i class="fas fa-edit me-2"></i>Edit
        </a>
        <a asp-controller="Appointments" asp-action="Index" class="btn btn-primary">
            <i class="fas fa-calendar-alt me-2"></i>Show Appointments
        </a>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Définir le nom du patient
        const patientName = '@Model.FullName';

        // Fonction pour déterminer le moment de la journée
        function getTimeGreeting() {
            const date = new Date();
            const hours = date.getHours();
            let greeting;

            if (hours >= 5 && hours < 18) {
                greeting = 'Bonjour';
            } else {
                greeting = 'Bonsoir';
            }

            return `${greeting}, ${patientName} !`;
        }

        // Mettre à jour le message de salutation
        document.addEventListener('DOMContentLoaded', () => {
            const greetingElement = document.getElementById('timeGreeting');
            greetingElement.textContent = getTimeGreeting();
        });
    </script>
}

<style>
    /* Custom Admin Dashboard Styles */
    .admin-header {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    .header-actions .btn {
        margin-right: 0.5rem;
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    .card-header {
        border-radius: 12px 12px 0 0;
        padding: 1.5rem;
    }

    .card-body {
        padding: 1.5rem;
    }

    .card-footer {
        border-radius: 0 0 12px 12px;
        padding: 1.5rem;
        background-color: #f8f9fa;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .form-control-static {
        padding: 0.375rem 0.75rem;
        background-color: #f8f9fa;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        margin-bottom: 0;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-warning {
        background-color: #ffc107;
        border-color: #ffc107;
    }

    .btn-danger {
        background-color: #dc3545;
        border-color: #dc3545;
    }

        .btn-primary:hover,
        .btn-warning:hover,
        .btn-danger:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .admin-header {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .header-actions {
            width: 100%;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .card-body .row {
            flex-direction: column;
        }

        .card-body .col-md-6 {
            width: 100%;
        }
    }
</style>