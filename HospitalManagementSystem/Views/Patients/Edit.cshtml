@model ApplicationUser

@{
    ViewData["Title"] = "Edit Patient";
}

<!-- Header Section -->
<div class="admin-header d-flex flex-wrap justify-content-between align-items-center p-4 mb-4 shadow-sm bg-white rounded">
    <div class="d-flex align-items-center">
        <i class="fas fa-user-edit fa-2x text-primary me-3"></i>
        <div>
            <h1 class="h3 mb-0">Edit Patient</h1>
            <h2 class="h5 mb-0 text-muted">Editing: @Model.FullName</h2>
        </div>
    </div>
    <div class="header-actions mt-2 mt-md-0">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<!-- Edit Form -->
<div class="card shadow-sm">
    <div class="card-header bg-light">
        <h5 class="card-title mb-0"><i class="fas fa-user-edit me-2"></i>Patient Details</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FullName" class="form-label fw-bold"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label fw-bold"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="Address" class="form-label fw-bold"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="DateOfBirth" class="form-label fw-bold"></label>
                        <input asp-for="DateOfBirth" class="form-control" type="date" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Récupérer les messages de succès et d'erreur
            var registrationSuccess = '@TempData["SuccessMessage"]';
            var registrationError = '@TempData["ErrorMessage"]';

            // Afficher un message de succès si disponible
            if (registrationSuccess) {
                Swal.fire({
                    icon: 'success',
                    title: 'Update Successful',
                    text: registrationSuccess,
                    confirmButtonText: 'OK'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Index", "Patients")'; // Redirection après confirmation
                    }
                });
            }

            // Afficher un message d'erreur si disponible
            if (registrationError) {
                Swal.fire({
                    icon: 'error',
                    title: 'Update Failed',
                    text: registrationError,
                    confirmButtonText: 'OK'
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = '@Url.Action("Index", "Patients")'; // Redirection après confirmation
                    }
                });
            }
        });
    </script>
}

<style>
    /* Custom Admin Dashboard Styles */
    .admin-header {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    .header-actions .btn {
        margin-right: 0.5rem;
    }

    .card {
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    }

    .card-header {
        border-radius: 12px 12px 0 0;
        padding: 1.5rem;
        background-color: #f8f9fa;
    }

    .card-body {
        padding: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .form-control {
        border-radius: 8px;
        border: 1px solid #e9ecef;
    }

    .btn {
        padding: 0.5rem 1rem;
        border-radius: 8px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
    }

    .btn-secondary {
        background-color: #6c757d;
        border-color: #6c757d;
    }

        .btn-primary:hover, .btn-secondary:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

    @@media (max-width: 768px) {
        .admin-header {
            flex-direction: column;
            align-items: flex-start !important;
        }

        .header-actions {
            width: 100%;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

        .card-body .row {
            flex-direction: column;
        }

        .card-body .col-md-6 {
            width: 100%;
        }
    }
</style>