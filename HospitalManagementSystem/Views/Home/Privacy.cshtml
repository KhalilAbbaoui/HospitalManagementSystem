@{
    ViewData["Title"] = "Privacy Policy";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="section-privacy py-5">
    <div class="container">
        <h1>@ViewData["Title"]</h1>
        <p>Your privacy is important to us. This policy outlines how we handle your personal information.</p>
        <h3>Data Collection</h3>
        <p>We collect information to provide better services to all our users.</p>
        <h3>Data Usage</h3>
        <p>We use the information we collect to improve our services and communicate with you.</p>
        <h3>Data Security</h3>
        <p>We take the security of your data seriously and implement measures to protect it.</p>
    </div>
</section>