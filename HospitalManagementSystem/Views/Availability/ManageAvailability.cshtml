@model IEnumerable<HospitalManagementSystem.Models.Availability>

@{
    ViewData["Title"] = "Manage Availability";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Availability</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Doctor
            </th>
            <th>
                Start Date
            </th>
            <th>
                End Date
            </th>
            <th>
                Start Time
            </th>
            <th>
                End Time
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                
                <td>
                    @item.StartDate.ToShortDateString()
                </td>
                <td>
                    @item.EndDate.ToShortDateString()
                </td>
                <td>
                    @(new DateTime(item.StartTime.Ticks).ToShortTimeString())
                </td>
                <td>
                    @(new DateTime(item.EndTime.Ticks).ToShortTimeString())
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Edit</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
