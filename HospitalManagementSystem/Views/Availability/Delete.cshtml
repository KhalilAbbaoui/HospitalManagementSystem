@model HospitalManagementSystem.Models.Availability

@{
    ViewData["Title"] = "Delete Availability";
}

<h1>@ViewData["Title"]</h1>

<h4>Are you sure you want to delete this availability?</h4>
<hr />

<div class="alert alert-warning">
    <strong>Warning!</strong> This action cannot be undone.
</div>

<div>
    <h4>Availability Details</h4>
    <dl class="row">
        <dt class="col-sm-2">
            Doctor
        </dt>
   
        <dt class="col-sm-2">
            Start Date
        </dt>
        <dd class="col-sm-10">
            @Model.StartDate.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            End Date
        </dt>
        <dd class="col-sm-10">
            @Model.EndDate.ToShortDateString()
        </dd>
        <dt class="col-sm-2">
            Start Time
        </dt>
        <dd class="col-sm-10">
            @(new DateTime(Model.StartTime.Ticks).ToShortTimeString())
        </dd>
        <dt class="col-sm-2">
            End Time
        </dt>
        <dd class="col-sm-10">
            @(new DateTime(Model.EndTime.Ticks).ToShortTimeString())
        </dd>
    </dl>
</div>

<form asp-action="DeleteAvailabilityConfirmed">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="ManageAvailability" class="btn btn-secondary">Cancel</a>
    </div>
</form>
